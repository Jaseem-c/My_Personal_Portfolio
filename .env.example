# Public URL of the deployed site (used for SEO, Open Graph, sitemap and robots.txt).
# On Vercel this falls back to the production domain automatically if left unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form — https://resend.com
# Without RESEND_API_KEY the form shows an honest "not configured" message and offers a direct email link.
RESEND_API_KEY=
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=seamjaseem@gmail.com
# Verified sender. Until you verify a domain in Resend, use the test sender below
# (it can only deliver to the email address your Resend account is registered with).
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
